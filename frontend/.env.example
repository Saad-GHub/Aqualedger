NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# --- WhatsApp bot (optional) --------------------------------------------------
# Meta app > WhatsApp > API Setup. Keep these on the server (Vercel env vars), never in git.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app > App settings > Basic > App secret (used to check webhook signatures)
WHATSAPP_APP_SECRET=
# Any random string; type the same value in Meta's webhook "Verify token" box
WHATSAPP_VERIFY_TOKEN=
# Public site link used in replies, e.g. https://your-app.vercel.app
PUBLIC_SITE_URL=
# Voice notes -> text (Groq Whisper, free tier). Without it voice notes are declined politely.
GROQ_API_KEY=
# Optional: better understanding of messages with Claude. Without it a keyword parser is used.
ANTHROPIC_API_KEY=
# Optional: let the bot save readings. Service role key is server-only; the user id is a
# dedicated "WhatsApp bot" account in Supabase Auth that WhatsApp reports are filed under.
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_REPORTER_USER_ID=
